#!/usr/bin/env zsh
# Usage: textconv <gpg-key-id> <file>
# Configure in gitconfig as: textconv = /path/to/textconv YOUR_KEY_ID
# key id unused for decrypt (recipient baked into ciphertext), kept for call compat

file="$2"

# anchored at byte 0 (27 = header length), must match clean's check exactly
if [[ "$(head -c 27 "$file")" == '-----BEGIN PGP MESSAGE-----' ]]
then
  gpg --decrypt -q < "$file"
else
  cat "$file"
fi
