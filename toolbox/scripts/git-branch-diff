#!/usr/bin/env zsh

# exported: fzf runs the preview in a subshell
export GIT_BRANCH_DIFF_BASE=$(git rev-parse --verify --quiet refs/heads/master > /dev/null && echo master || echo main)

selected_branch=$(
  git branch --format='%(refname:short)' \
    | grep -v "^${GIT_BRANCH_DIFF_BASE}$" \
    | fzf \
        --ansi \
        --prompt="branch> " \
        --preview='
          # log takes two dots; three would be the symmetric difference and pull in base commits
          git log --color=always --format="%C(auto)%h %C(green)%cd%C(reset) %s" --date=short "${GIT_BRANCH_DIFF_BASE}..{}"
          echo
          git diff --numstat "${GIT_BRANCH_DIFF_BASE}...{}" | awk '"'"'BEGIN{green="\033[32m"; red="\033[31m"; reset="\033[0m"} {printf "%s+%s%s %s-%s%s  %s\n", green, $1, reset, red, $2, reset, $3}'"'"'
          echo
          # explicit width: delta cannot detect the fzf preview pane
          git diff "${GIT_BRANCH_DIFF_BASE}...{}" | delta --width="$FZF_PREVIEW_COLUMNS"
        ' \
        --preview-window=right:80%
)

[[ -z "$selected_branch" ]] && exit 0

git diff "${GIT_BRANCH_DIFF_BASE}...${selected_branch}"
