{
  "suggest.noselect": false,
  "list.normalMappings": {
    "<C-c>": "do:exit"
  },
  "list.insertMappings": {
    "<C-c>": "do:exit"
  },
  "codeLens.enable": false,
  "eslint.autoFixOnSave": true,
  "eslint.probe": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "svelte",
    "astro",
    "civet",
    "html",
    "mdx",
    "vue",
    "markdown",
    "json",
    "jsonc"
  ],
  "coc.preferences.formatOnSave": true,
  "python.formatting.provider": "black",
  "javascript.suggestionActions.enabled": false,
  "solargraph.formatting": true,
  "solargraph.autoformat": true,
  "solargraph.hover": true,
  "solargraph.diagnostics": true,
  "solargraph.transport": "stdio",
  "prettier.formatterPriority": 1,
  "prettier.proseWrap": "always",
  "prettier.documentSelectors": ["**/*.svelte"],
  "json.schemas": [
    {
      "fileMatch": ["manifest.json"],
      "url": "https://json.schemastore.org/chrome-manifest.json"
    }
  ],
  "coc.source.word.filetypes": ["markdown", "gitcommit"],
  "coc.source.emoji.filetypes": ["markdown", "gitcommit"],
  "coc.source.dictionary.filetypes": ["markdown", "gitcommit"],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "emmet.includeLanguages": { "svelte": "html" },
  "languageserver": {
    "svelte": {
      "command": "~/.dotfiles/vim/neovim/svelte-language-server",
      "args": ["--stdio"],
      "filetypes": ["svelte"],
      "rootPatterns": ["svelte.config.js", "package.json", ".git"]
    }
  },
  "sumneko-lua.enableNvimLuaDev": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  "snippets.ultisnips.pythonPrompt": false
}
